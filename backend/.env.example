# Server Configuration
PORT=5000
NODE_ENV=production

# Database — Your MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/student-engagement?retryWrites=true&w=majority

# JWT — Generate a strong random secret (use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))")
JWT_SECRET=CHANGE_ME_TO_A_STRONG_RANDOM_STRING

# JWT Token Expiry
JWT_EXPIRE=7d

# AI Service (optional)
OPENAI_API_KEY=
AI_BOT_ENABLED=true

# Frontend URL — Your Netlify/Vercel deployment URL (for CORS)
FRONTEND_URL=https://your-app.netlify.app

# File Upload
MAX_FILE_SIZE=10485760
UPLOAD_DIR=./uploads
